{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",

    // React Compiler-style checks. Intentional exceptions carry an inline
    // oxlint-disable comment that says why.
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "react/purity": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/memo-dependencies": "error",
    "react/no-unstable-nested-components": "error",
    "react/incompatible-library": "error", // e.g. use useWatch(), not form.watch()

    // Deliberate patterns in this codebase.
    "import/no-named-as-default-member": "off", // pg is CommonJS: pg.Pool / pg.DatabaseError is the supported form
    "import/no-unassigned-import": "off", // CSS and font side-effect imports
    "unicorn/consistent-function-scoping": "off", // small closures kept next to their only use
    "unicorn/prefer-add-event-listener": "off", // onmessage/onload on XHR, WebSocket and FileReader
    "unicorn/no-array-sort": "off", // sorting fresh local arrays in place is intended
    "unicorn/no-new-array": "off", // new Array(n) to preallocate results by index
    "eslint/no-shadow": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/.astro/**", "**/node_modules/**"]
}

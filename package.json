{
  "name": "decktools",
  "private": true,
  "description": "Monorepo for the Deck tools: zero-install web UIs for infrastructure, run with npx.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/decktools.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter \"./tools/*\" build",
    "dev": "pnpm --filter pgdeck dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pgdeck": "pnpm --filter pgdeck",
    "site:dev": "pnpm --filter deck-site dev",
    "site:build": "pnpm --filter deck-site build"
  },
  "devDependencies": {
    "oxlint": "^1.95.0",
    "pgdeck": "workspace:*",
    "s3deck": "workspace:*"
  }
}

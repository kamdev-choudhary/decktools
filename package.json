{
  "name": "pgdeck",
  "version": "0.1.2",
  "description": "A fast, modern web UI for PostgreSQL. Run it with npx, browse and edit data, run SQL, and watch live stats.",
  "keywords": [
    "postgres",
    "postgresql",
    "database",
    "admin",
    "gui",
    "web-ui",
    "sql",
    "pgadmin",
    "dashboard",
    "cli",
    "npx"
  ],
  "homepage": "https://github.com/kamdev-choudhary/pgdeck#readme",
  "bugs": {
    "url": "https://github.com/kamdev-choudhary/pgdeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/pgdeck.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pgdeck": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && pnpm build:web && pnpm build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsdown",
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch src/cli/index.ts --no-auth",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "commander": "^15.1.0",
    "hono": "^4.13.20",
    "open": "^11.0.4",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pg-copy-streams": "^7.0.0",
    "pg-cursor": "^2.22.1",
    "picocolors": "^1.1.1",
    "ws": "^8.23.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yazl": "^3.3.1",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3",
    "vite": "^8.3.8"
  }
}

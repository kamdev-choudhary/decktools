{
  "name": "decktools",
  "private": true,
  "description": "Monorepo for the Deck tools: zero-install web UIs for infrastructure, run with npx.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/decktools.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter \"./tools/*\" build",
    "dev": "pnpm --filter \"./tools/*\" --parallel --no-bail dev",
    "dev:pgdeck": "pnpm --filter pgdeck dev",
    "dev:s3deck": "pnpm --filter s3deck dev",
    "dev:redisdeck": "pnpm --filter redisdeck dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "site:dev": "pnpm --filter deck-site dev",
    "site:build": "pnpm --filter deck-site build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "oxlint": "catalog:",
    "pgdeck": "workspace:*",
    "prettier": "^3.10.1",
    "redisdeck": "workspace:*",
    "s3deck": "workspace:*"
  }
}

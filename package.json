{
  "name": "deck-tools",
  "private": true,
  "description": "Monorepo for the Deck tools: zero-install web UIs for infrastructure, run with npx.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter \"./tools/*\" build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter pgdeck dev",
    "pgdeck": "pnpm --filter pgdeck",
    "site:dev": "pnpm --filter pgdeck-site dev",
    "site:build": "pnpm --filter pgdeck-site build"
  }
}

---
const snippets = [
  {
    id: 'examples',
    label: 'Examples',
    lang: 'bash',
    code: `# Local database, open the browser for you
npx pgdeck postgres://postgres@localhost:5432 --open

# Production, read-only, with a fixed password
PGDECK_PASSWORD='correct horse battery staple' \\
  npx pgdeck "$DATABASE_URL" --readonly

# Managed Postgres that requires SSL
npx pgdeck "postgres://user:pass@db.example.com/app?sslmode=require"

# In a container or on your LAN
npx pgdeck postgres://postgres@db:5432 --host 0.0.0.0 --password "$SECRET"`,
  },
  {
    id: 'nginx',
    label: 'nginx',
    lang: 'nginx',
    code: `# npx pgdeck "$DATABASE_URL" --base-path /db --password "$SECRET"
location /db/ {
    proxy_pass http://127.0.0.1:47615;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Large imports: stream uploads, no size limit
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_read_timeout 1h;
}`,
  },
  {
    id: 'caddy',
    label: 'Caddy',
    lang: 'caddy',
    code: `# handle_path strips /db, so start pgdeck without --base-path
example.com {
    handle_path /db/* {
        reverse_proxy 127.0.0.1:47615
    }
}`,
  },
];

const options = [
  ['--readonly', 'Read-only sessions, no editing'],
  ['--password', 'Fixed login instead of a random one'],
  ['--host 0.0.0.0', 'Listen beyond localhost'],
  ['--base-path /db', 'Serve under a path prefix'],
  ['--ssl', 'SSL without certificate checks'],
  ['--open', 'Open the UI in your browser'],
] as const;

const safety = [
  ['Login by default', 'A random password is printed at startup. Sessions are HTTP-only, SameSite=Strict cookies, and failed logins are rate-limited.'],
  ['Local unless you say so', 'pgdeck binds to 127.0.0.1, and warns if you expose it without a login.'],
  ['Other sites can’t use your session', 'API calls need a custom header and WebSockets check their Origin.'],
  ['Least privilege works', 'pgdeck can do what its role can do, nothing more. Connect as a read-only role for anything sensitive.'],
] as const;
---

<section id="deploy" class="border-t border-line bg-tide-soft py-20 md:py-28">
  <div class="wrap">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:gap-16">
      <div>
        <h2 class="h2">Run it next to your database.</h2>
        <p class="lede mt-5">
          pgdeck is one Node process on one port. Run it on your laptop for a local database, or on a server behind
          nginx or Caddy to reach it from anywhere. It works at the root of a domain or under a path.
        </p>
        <dl class="mt-8 divide-y divide-line border-y border-line">
          {
            options.map(([flag, what]) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                <dt class="font-mono text-[0.85rem] text-elephant">{flag}</dt>
                <dd class="text-[0.95rem] text-ink-soft">{what}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="codetabs min-w-0">
        <div role="tablist" aria-label="Setup examples" class="flex gap-1">
          {
            snippets.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`ctab-${s.id}`}
                aria-controls={`cpanel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="h-9 rounded-lg px-3.5 text-sm font-semibold text-ink-soft transition-colors hover:text-ink aria-selected:bg-term aria-selected:text-term-ink"
              >
                {s.label}
              </button>
            ))
          }
        </div>
        {
          snippets.map((s, i) => (
            <div role="tabpanel" id={`cpanel-${s.id}`} aria-labelledby={`ctab-${s.id}`} hidden={i !== 0} class="mt-3">
              <pre class="code overflow-x-auto rounded-2xl bg-term p-6 text-term-ink" tabindex="0"><code>{s.code}</code></pre>
            </div>
          ))
        }
        <p class="mt-4 text-sm text-ink-faint">
          Live stats use a WebSocket, so forward upgrades. <span class="font-mono">GET /healthz</span> answers without a login, for uptime checks.
        </p>
      </div>
    </div>

    <div class="mt-20">
      <h3 class="text-[1.35rem] font-bold tracking-tight">It holds the keys to your data, so it’s careful with them.</h3>
      <dl class="mt-6 grid gap-x-10 border-t border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          safety.map(([term, desc]) => (
            <div class="border-b border-line py-5 lg:border-b-0">
              <dt class="font-semibold">{term}</dt>
              <dd class="mt-1.5 text-[0.93rem] text-ink-soft">{desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.codetabs [role=tab]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
      if (step) {
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length]!, true);
      }
    });
  });
</script>

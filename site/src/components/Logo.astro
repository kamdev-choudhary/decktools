---
/** pgdeck mark: three stacked slabs, a "deck" of tables. Same drawing as the app. */
interface Props {
  class?: string;
}
const { class: className = 'size-7' } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <rect width="32" height="32" rx="8" class="fill-elephant"></rect>
  <g class="fill-paper">
    <rect x="8" y="8.5" width="16" height="3.5" rx="1.75"></rect>
    <rect x="8" y="14.25" width="16" height="3.5" rx="1.75" opacity="0.7"></rect>
    <rect x="8" y="20" width="10" height="3.5" rx="1.75" opacity="0.45"></rect>
  </g>
</svg>

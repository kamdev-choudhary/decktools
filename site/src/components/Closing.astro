---
import CopyCommand from './CopyCommand.astro';
import Logo from './Logo.astro';
const repo = 'https://github.com/kamdev-choudhary/pgdeck';
---

<section class="relative isolate overflow-hidden bg-night py-28 text-center text-night-ink md:py-36">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_60%_70%_at_50%_100%,#000_10%,transparent_70%)]" aria-hidden="true"></div>
  <div class="glow pointer-events-none absolute -bottom-72 left-1/2 -z-10 h-[34rem] w-[min(60rem,120vw)] -translate-x-1/2" aria-hidden="true"></div>
  <div class="wrap">
    <h2 class="display headline-ink mx-auto max-w-[15ch] text-[clamp(2.6rem,1.4rem+4.8vw,5.2rem)]">Point it at a database and press Enter.</h2>
    <p class="mx-auto mt-6 max-w-[46ch] text-[1.1rem] text-night-soft">It prints a link and a password. Open the link. That’s the whole setup.</p>
    <div class="mx-auto mt-10 flex max-w-2xl flex-col gap-3 sm:flex-row sm:items-center">
      <CopyCommand command="npx pgdeck postgres://localhost:5432" class="flex-1 !border-night-line !bg-night-raised text-left [&_code]:!text-night-ink" />
      <a href={repo} class="inline-flex h-[3.35rem] items-center justify-center rounded-xl bg-night-ink px-6 font-semibold text-night transition-opacity hover:opacity-85">
        Star on GitHub
      </a>
    </div>
  </div>
</section>

<footer class="bg-night text-night-soft">
  <div class="wrap flex flex-col gap-4 border-t border-night-line py-8 text-sm sm:flex-row sm:items-center">
    <span class="flex items-center gap-2 font-semibold text-night-ink">
      <Logo class="size-5" /> pgdeck
    </span>
    <span>Open source under the MIT license.</span>
    <nav class="flex gap-5 sm:ml-auto" aria-label="Footer">
      <a href={repo} class="hover:text-night-ink">GitHub</a>
      <a href="https://www.npmjs.com/package/pgdeck" class="hover:text-night-ink">npm</a>
      <a href={`${repo}/issues`} class="hover:text-night-ink">Report an issue</a>
    </nav>
  </div>
</footer>

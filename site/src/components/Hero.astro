---
import CopyCommand from './CopyCommand.astro';
import Shot from './Shot.astro';

const command = 'npx pgdeck postgres://localhost:5432/shop';
---

<section id="top" class="relative overflow-hidden">
  <div class="wrap pt-16 pb-10 md:pt-24">
    <h1 class="display max-w-[14ch] text-[clamp(3rem,1.6rem+6.2vw,6.4rem)]">Postgres, open in a browser tab.</h1>
    <div class="mt-8 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] md:items-end md:gap-12">
      <p class="lede">
        pgdeck is a web admin for PostgreSQL that starts with one command. Browse and edit rows, run SQL, change tables
        and watch live activity on every database on your server. Nothing to install, no account to make.
      </p>
      <div class="space-y-3">
        <CopyCommand command="npx pgdeck postgres://user:pass@host:5432/db" />
        <p class="text-sm text-ink-faint">Needs Node.js 20 or newer and PostgreSQL 12 or newer. Free and MIT licensed.</p>
      </div>
    </div>
  </div>

  <!-- The one orchestrated moment: the command runs, pgdeck answers, the app opens. -->
  <div class="wrap pb-20 md:pb-28">
    <div class="stage relative md:pt-10">
      <div class="term relative z-10 w-full rounded-2xl bg-term p-5 shadow-none ring-1 ring-black/5 md:absolute md:bottom-[-2.5rem] md:left-0 md:w-[27rem] dark:ring-white/10">
        <div class="mb-4 flex gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-term-dim/50"></span>
          <span class="size-2.5 rounded-full bg-term-dim/50"></span>
          <span class="size-2.5 rounded-full bg-term-dim/50"></span>
        </div>
        <div class="code overflow-x-auto whitespace-pre text-term-ink [scrollbar-width:none]" role="img" aria-label={`Terminal running ${command}, then pgdeck printing its web address and login`}>
          <div><span class="text-term-dim">~ $ </span><span class="type inline-block overflow-hidden align-bottom" style={`--n:${command.length}`}>{command}</span></div>
          <div class="out mt-3" style="--i:0">  <span class="font-semibold">pgdeck</span> <span class="text-term-dim">v0.1.2</span></div>
          <div class="out mt-3" style="--i:1">  <span class="text-term-ok">✓ Connected</span>   shop as postgres <span class="text-term-dim">(PostgreSQL 18)</span></div>
          <div class="out" style="--i:2">    <span class="text-term-dim">Databases</span>   35 available</div>
          <div class="out" style="--i:3">  <span class="text-term-link">➜ Web UI      http://127.0.0.1:47615/</span></div>
          <div class="out" style="--i:4">    <span class="text-term-dim">Login</span>       admin / p4n5DDweB04s</div>
        </div>
      </div>

      <div class="app frame mt-4 md:mt-0 md:ml-[12%]">
        <div class="frame-bar" aria-hidden="true">
          <div class="flex gap-1.5">
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
          </div>
          <div class="mx-auto flex h-6 w-full max-w-sm items-center justify-center rounded-md bg-paper-raised px-3 font-mono text-[0.7rem] text-ink-faint ring-1 ring-line">
            127.0.0.1:47615
          </div>
          <div class="w-10"></div>
        </div>
        <Shot
          name="overview"
          alt="The pgdeck overview: connection, transaction and cache stats, live charts of transactions and rows per second, and the active sessions on the shop database."
          eager
          sizes="(min-width: 1216px) 1000px, 92vw"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .type {
    width: calc(var(--n) * 1ch);
    animation: type 1.1s steps(var(--n)) 0.35s both;
  }
  .out {
    opacity: 0;
    animation: line 0.25s ease-out both;
    animation-delay: calc(1.65s + var(--i) * 0.13s);
  }
  .app {
    animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 2.45s both;
  }
  @keyframes type {
    from {
      width: 0;
    }
  }
  @keyframes line {
    to {
      opacity: 1;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(2.5rem) scale(0.985);
    }
  }
</style>

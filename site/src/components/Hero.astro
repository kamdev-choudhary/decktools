---
import CopyCommand from './CopyCommand.astro';
import Shot from './Shot.astro';

const command = 'npx pgdeck postgres://localhost:5432/shop';
---

<section id="top" class="relative isolate overflow-hidden bg-night text-night-ink">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow pointer-events-none absolute top-[36rem] left-1/2 -z-10 h-[46rem] w-[min(78rem,140vw)] -translate-x-1/2" aria-hidden="true"></div>

  <div class="wrap relative pt-16 text-center md:pt-24">
    <a
      href="https://github.com/kamdev-choudhary/pgdeck/releases"
      class="intro inline-flex items-center gap-2 rounded-full border border-night-line bg-night-raised/70 py-1 pr-3.5 pl-1 text-[0.82rem] text-night-soft transition-colors hover:text-night-ink"
      style="--d:0"
    >
      <span class="rounded-full bg-glow/30 px-2.5 py-0.5 font-semibold text-night-ink">New</span>
      Create tables and manage indexes in 0.1.2
    </a>
    <h1 class="intro display headline-ink mx-auto mt-7 max-w-[13ch] text-[clamp(3.1rem,1.4rem+7.2vw,7.2rem)]" style="--d:1">
      Postgres, open in a browser tab.
    </h1>
    <p class="intro mx-auto mt-7 max-w-[52ch] text-[1.15rem] leading-relaxed text-night-soft md:text-[1.25rem]" style="--d:2">
      A web admin for PostgreSQL that starts with one command. Browse and edit rows, run SQL, change tables and watch
      live activity on every database on your server.
    </p>
    <div class="intro mx-auto mt-10 flex max-w-xl flex-col items-stretch gap-3" style="--d:3">
      <div class="cmd-glow rounded-[14px] p-px">
        <CopyCommand command="npx pgdeck postgres://user:pass@host:5432/db" class="!border-0 !bg-night-raised text-left !text-night-ink [&_code]:!text-night-ink" />
      </div>
      <p class="text-[0.83rem] text-night-soft/80">Node.js 20+ and PostgreSQL 12+. Nothing to install. MIT licensed.</p>
    </div>
  </div>

  <!-- The one orchestrated moment: the command runs, pgdeck answers, the app opens and settles flat as you scroll. -->
  <div class="wrap relative mt-16 pb-24 md:mt-20 md:pb-32">
    <div class="stage relative">
      <div class="app-in">
        <div class="tilt rounded-[18px] bg-gradient-to-b from-white/25 to-white/5 p-px">
          <div class="overflow-hidden rounded-[17px] bg-night-raised">
            <div class="flex h-10 items-center gap-3 border-b border-night-line px-4" aria-hidden="true">
              <div class="flex gap-1.5">
                <span class="size-2.5 rounded-full bg-[#ff5f57]/80"></span>
                <span class="size-2.5 rounded-full bg-[#febc2e]/80"></span>
                <span class="size-2.5 rounded-full bg-[#28c840]/80"></span>
              </div>
              <div class="mx-auto flex h-6 w-full max-w-xs items-center justify-center gap-1.5 rounded-md bg-night px-3 font-mono text-[0.7rem] text-night-soft">
                <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                127.0.0.1:47615
              </div>
              <div class="w-12"></div>
            </div>
            <Shot
              name="overview"
              alt="The pgdeck overview: connection, transaction and cache stats, live charts of transactions and rows per second, and the active sessions on the shop database."
              eager
              sizes="(min-width: 1216px) 1150px, 94vw"
            />
          </div>
        </div>
      </div>

      <div class="term relative z-10 mt-5 w-full rounded-2xl border border-night-line bg-term/95 p-5 backdrop-blur md:absolute md:-bottom-10 md:-left-6 md:mt-0 md:w-[27.5rem] lg:-left-10">
        <div class="mb-4 flex items-center gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-term-dim/40"></span>
          <span class="size-2.5 rounded-full bg-term-dim/40"></span>
          <span class="size-2.5 rounded-full bg-term-dim/40"></span>
          <span class="ml-auto font-mono text-[0.68rem] text-term-dim">zsh</span>
        </div>
        <div class="code overflow-x-auto whitespace-pre text-term-ink [scrollbar-width:none]" role="img" aria-label={`Terminal running ${command}, then pgdeck printing its web address and login`}>
          <div><span class="text-term-dim">~ $ </span><span class="type inline-block overflow-hidden align-bottom" style={`--n:${command.length}`}>{command}</span></div>
          <div class="out mt-3" style="--i:0">  <span class="font-semibold">pgdeck</span> <span class="text-term-dim">v0.1.2</span></div>
          <div class="out mt-3" style="--i:1">  <span class="text-term-ok">✓ Connected</span>   shop as postgres <span class="text-term-dim">(PostgreSQL 18)</span></div>
          <div class="out" style="--i:2">    <span class="text-term-dim">Databases</span>   35 available</div>
          <div class="out" style="--i:3">  <span class="text-term-link">➜ Web UI      http://127.0.0.1:47615/</span></div>
          <div class="out" style="--i:4">    <span class="text-term-dim">Login</span>       admin / 7Qm2xLpR9vKe</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    animation: intro 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--d) * 0.08s);
  }
  .cmd-glow {
    background: linear-gradient(120deg, rgba(134, 179, 220, 0.7), rgba(134, 179, 220, 0.08) 40%, rgba(134, 179, 220, 0.08) 60%, rgba(240, 179, 78, 0.55));
  }
  .type {
    width: calc(var(--n) * 1ch);
    animation: type 1.1s steps(var(--n)) 0.7s both;
  }
  .out {
    opacity: 0;
    animation: fade 0.25s ease-out both;
    animation-delay: calc(2s + var(--i) * 0.13s);
  }
  .app-in {
    animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 2.7s both;
  }
  .tilt {
    transform-origin: 50% 0;
    transform: perspective(1800px) rotateX(14deg) scale(0.95);
  }
  @supports (animation-timeline: view()) {
    .tilt {
      animation: flatten linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 42%;
    }
  }
  @supports not (animation-timeline: view()) {
    .tilt {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tilt {
      transform: none !important;
      animation: none !important;
    }
  }
  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes type {
    from {
      width: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(3rem);
    }
  }
  @keyframes flatten {
    from {
      transform: perspective(1800px) rotateX(14deg) scale(0.95);
    }
    to {
      transform: none;
    }
  }
</style>

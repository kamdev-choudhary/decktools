---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

/**
 * A product screenshot in its light and dark variants, swapped by the
 * visitor's color scheme. Sources are 2880×1800 PNGs; we ship WebP.
 */
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { name, alt, eager = false, sizes = '(min-width: 1200px) 1100px, 100vw', class: className } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const pick = (theme: string) => {
  const f = files[`../assets/shots/${name}-${theme}.png`];
  if (!f) throw new Error(`Missing screenshot ${name}-${theme}.png`);
  return f.default;
};
const widths = [720, 1100, 1600, 2200];
const [light, dark] = await Promise.all(
  ['light', 'dark'].map((t) => getImage({ src: pick(t), widths, format: 'webp', quality: 82 })),
);
---

<picture class={className}>
  <source media="(prefers-color-scheme: dark)" srcset={dark!.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={light!.src}
    srcset={light!.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width="1440"
    height="900"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="block h-auto w-full"
  />
</picture>

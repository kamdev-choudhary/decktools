---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

/** A product screenshot (dark theme, 2880×1800 source), served as responsive WebP. */
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { name, alt, eager = false, sizes = '(min-width: 1200px) 1100px, 100vw', class: className } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const file = files[`../assets/shots/${name}-dark.png`];
if (!file) throw new Error(`Missing screenshot ${name}-dark.png`);
const img = await getImage({ src: file.default, widths: [720, 1100, 1600, 2200], format: 'webp', quality: 82 });
---

<img
  src={img.src}
  srcset={img.srcSet.attribute}
  sizes={sizes}
  alt={alt}
  width="1440"
  height="900"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class:list={['block h-auto w-full', className]}
/>

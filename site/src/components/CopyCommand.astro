---
/** A shell command with a copy button. */
interface Props {
  command: string;
  class?: string;
}
const { command, class: className } = Astro.props;
---

<div class:list={['flex min-w-0 items-center gap-3 rounded-full border border-line-strong bg-surface py-1.5 pr-1.5 pl-5 font-mono text-[0.84rem]', className]}>
  <span class="select-none text-faint" aria-hidden="true">$</span>
  <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-fg [scrollbar-width:none]">{command}</code>
  <button
    type="button"
    data-copy={command}
    aria-label="Copy command"
    class="inline-flex size-9 shrink-0 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-fg"
  >
    <svg data-icon="copy" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg data-icon="done" viewBox="0 0 24 24" class="hidden size-4 text-green" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </button>
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      } catch {
        return;
      }
      const [copy, done] = [btn.querySelector('[data-icon=copy]'), btn.querySelector('[data-icon=done]')];
      copy?.classList.add('hidden');
      done?.classList.remove('hidden');
      btn.setAttribute('aria-label', 'Copied');
      setTimeout(() => {
        copy?.classList.remove('hidden');
        done?.classList.add('hidden');
        btn.setAttribute('aria-label', 'Copy command');
      }, 1600);
    });
  }
</script>

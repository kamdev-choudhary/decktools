---
/** A small "+" where hairlines meet. Position it with classes. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 13 13" class:list={['pointer-events-none absolute z-10 size-[13px] text-faint', className]} aria-hidden="true">
  <path d="M6.5 0v13M0 6.5h13" stroke="currentColor" stroke-width="1"></path>
</svg>

---
const items = [
  ['Every database on the server', 'Switch with ⌘K, no restart. Create, copy, rename and drop databases from the same menu.'],
  ['Live overview', 'Transactions and rows per second streamed over a WebSocket, running sessions, storage per table, and health checks that fix what they find in one click.'],
  ['Foreign keys you can follow', 'Preview the referenced row from any cell, jump to it, or see every table that points back at this one.'],
  ['Values stay exact', 'Everything travels as Postgres text. Timestamps keep their zone and precision; bigint and numeric never lose a digit to JavaScript.'],
  ['Filters that combine', 'Equals, contains, starts with, in, like, is null and more, joined with AND or OR.'],
  ['Table actions', 'Rename, duplicate with or without data, truncate, vacuum, analyze, refresh views, drop, or copy the CREATE statement.'],
  ['Backups that restore', 'Write a consistent pg_dump-style backup, and restore plain or gzipped SQL dumps, or custom-format ones when pg_restore is installed.'],
  ['Read-only when it matters', 'Start with --readonly and every session is read-only and editing disappears from the UI.'],
] as const;
---

<section id="details" class="py-20 md:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="h2">Built for the work you actually do in a database.</h2>
      <p class="lede mt-5">Small things, done carefully. Nothing here needs a plugin, a config file or a second tool.</p>
    </div>
    <dl class="grid border-t border-line sm:grid-cols-2 sm:gap-x-10">
      {
        items.map(([term, desc]) => (
          <div class="border-b border-line py-6">
            <dt class="text-[1.08rem] font-semibold tracking-tight">{term}</dt>
            <dd class="mt-2 text-[0.97rem] text-ink-soft">{desc}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

---
import Corners from './Corners.astro';
import Cross from './Cross.astro';

// A deterministic "live" series for the sparkline, shaped like the app's chart.
const N = 64;
let seed = 7;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const values = Array.from({ length: N }, (_, i) => 190 + 55 * Math.sin(i / 6) + 30 * Math.sin(i / 2.3) + (rand() - 0.5) * 40);
const W = 640;
const H = 170;
const x = (i: number) => (i / (N - 1)) * W;
const y = (v: number) => H - (v / 320) * H;
const line = values.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
const area = `${line} L${W} ${H} L0 ${H} Z`;
const last = values.at(-1)!;

const icon = {
  key: '<path d="M2.6 18.4 9 12"/><circle cx="15" cy="9" r="5"/><path d="M15 9h.01"/><path d="m5 16 2 2"/>',
  exact: '<path d="M4 7h16M4 12h10M4 17h6"/><path d="m16 15 2 2 4-4"/>',
  actions: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>',
  backup: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  heart: '<path d="M3 12h4l3-7 4 14 3-7h4"/>',
  proxy: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  keys: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10"/>',
  theme: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
};

const cells = [
  ['key', 'Foreign keys you can follow', 'Preview the referenced row from any cell, jump to it, or see every table pointing back.'],
  ['exact', 'Values stay exact', 'Everything travels as Postgres text: timestamps keep their zone, numeric and bigint never lose a digit.'],
  ['actions', 'Table actions', 'Rename, duplicate, truncate, vacuum, analyze, refresh, drop, or copy the CREATE statement.'],
  ['backup', 'Backups that restore', 'Consistent pg_dump-style backups out; plain, gzipped or custom-format dumps back in.'],
  ['heart', 'Health checks that act', 'Never-analyzed tables, dead rows, missing indexes, with a button that fixes them.'],
  ['lock', 'Read-only when it matters', 'Start with --readonly and every session is read-only and editing disappears.'],
  ['proxy', 'Works behind any proxy', 'Relative URLs, an optional base path, and WebSockets that pass through nginx or Caddy.'],
  ['keys', 'Fast from the keyboard', '⌘K to switch databases, ⌘Enter to run SQL or save a row, Esc to close.'],
  ['theme', 'Light and dark', 'Follows your system, or pick one. Charts and code are tuned for both.'],
] as const;

const columns = [
  { name: 'id', type: 'bigint', flags: ['PK', 'NN', 'AI'], ref: '' },
  { name: 'customer_id', type: 'uuid', flags: ['NN'], ref: 'customers.id' },
  { name: 'total', type: 'numeric(12,2)', flags: [], ref: '' },
  { name: 'created_at', type: 'timestamptz', flags: ['NN'], ref: '' },
];
// SQL lines as highlighted HTML, built here so formatters can't re-indent them.
const kw = (t: string) => `<span class="text-pink">${t}</span>`;
const id = (t: string) => `<span class="text-blue">${t}</span>`;
const ty = (t: string) => `<span class="text-green">${t}</span>`;
const sqlLines = [
  `${kw('CREATE TABLE')} ${id('"public"."invoices"')} (`,
  `  "id" ${ty('bigint')} ${kw('GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY')},`,
  `  "customer_id" ${ty('uuid')} ${kw('NOT NULL')},`,
  `  "total" ${ty('numeric(12,2)')},`,
  `  "created_at" ${ty('timestamptz')} ${kw('DEFAULT')} now() ${kw('NOT NULL')},`,
  `  ${kw('FOREIGN KEY')} ("customer_id") ${kw('REFERENCES')} ${id('"public"."customers"')} ("id")`,
  `);`,
  ``,
  `${kw('CREATE INDEX CONCURRENTLY ON')} ${id('"public"."invoices"')}`,
  `  ("created_at" ${kw('DESC')});`,
];
---

<section id="features" class="section">
  <Corners />
  <div class="pad py-20 md:py-28">
    <div class="max-w-2xl">
      <h2 class="h2">Built for the work you actually do in a database.</h2>
      <p class="lede mt-5">Not a stripped-down viewer. Editing, schema changes, imports, backups and monitoring, in one tab.</p>
    </div>

    <div class="mt-12 grid gap-3 md:grid-cols-6">
      <!-- Live overview -->
      <article class="tile md:col-span-4">
        <div class="p-6 pb-0 md:p-8 md:pb-0">
          <h3 class="tile-title">Live overview</h3>
          <p class="tile-body max-w-[46ch]">Transactions and rows per second streamed every two seconds, with sessions, storage and health checks.</p>
        </div>
        <div class="mt-auto px-6 pt-8 md:px-8">
          <div class="flex flex-wrap items-end gap-x-8 gap-y-2">
            <div>
              <div class="text-xs text-faint">Transactions / s</div>
              <div class="text-4xl font-semibold tracking-tight tabular-nums">{Math.round(last)}</div>
            </div>
            <div class="flex items-center gap-4 pb-1.5 text-xs text-muted">
              <span class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-blue"></span>Commits</span>
              <span class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-pink"></span>Rollbacks</span>
            </div>
            <span class="mb-1.5 ml-auto inline-flex items-center gap-2 rounded-full border border-line-strong px-2.5 py-1 text-xs">
              <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-green opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-green"></span></span>
              Live
            </span>
          </div>
          <svg viewBox={`0 0 ${W} ${H + 10}`} class="mt-4 block h-auto w-full" role="img" aria-label="A line chart of transactions per second, rising and falling around 200">
            <defs>
              <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#3291ff" stop-opacity="0.3"></stop>
                <stop offset="1" stop-color="#3291ff" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="#1f1f1f" stroke-dasharray="3 5" />)}
            <path d={area} fill="url(#spark-fill)"></path>
            <path d={line} fill="none" stroke="#3291ff" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" pathLength="1" class="spark-line"></path>
            <line x1="0" x2={W} y1={H - 1} y2={H - 1} stroke="#e5489e" stroke-width="2"></line>
            <circle cx={W - 3} cy={y(last)} r="4.5" fill="#3291ff" stroke="#0a0a0a" stroke-width="2"></circle>
          </svg>
        </div>
      </article>

      <!-- Database switcher -->
      <article class="tile md:col-span-2">
        <div class="p-6 md:p-7">
          <h3 class="tile-title">Every database, one ⌘K away</h3>
          <p class="tile-body">Switch without restarting. Create, copy, rename and drop databases.</p>
        </div>
        <div class="mx-6 mt-auto mb-6 overflow-hidden rounded-xl border border-line-strong bg-bg text-[0.84rem] md:mx-7" aria-hidden="true">
          <div class="flex items-center gap-2 border-b border-line px-3 py-2.5 text-faint">
            <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            Find a database…
            <span class="ml-auto rounded border border-line px-1 font-mono text-[0.65rem]">⌘K</span>
          </div>
          {
            [
              ['shop', '18.7 MB', true],
              ['analytics', '1.2 GB', false],
              ['staging', '640 MB', false],
              ['auth', '24 MB', false],
            ].map(([name, size, on]) => (
              <div class:list={['flex items-center gap-2 px-3 py-2', on && 'bg-surface-2']}>
                <span class:list={['w-3.5 text-blue', !on && 'opacity-0']}>✓</span>
                <span class="flex-1">{name}</span>
                {on && <span class="rounded border border-line-strong px-1.5 text-[0.65rem] text-muted">default</span>}
                <span class="text-[0.72rem] text-faint tabular-nums">{size}</span>
              </div>
            ))
          }
          <div class="border-t border-line px-3 py-2 text-[0.8rem] font-medium">+ New database</div>
        </div>
      </article>

      <!-- Type-aware editing -->
      <article class="tile md:col-span-2">
        <div class="p-6 md:p-7">
          <h3 class="tile-title">Editors that know the type</h3>
          <p class="tile-body">Menus for enums, a calendar for timestamps, checked JSON, UUIDs in the version you already use.</p>
        </div>
        <div class="mx-6 mt-auto mb-6 space-y-2 text-[0.8rem] md:mx-7" aria-hidden="true">
          <div class="flex items-center gap-2">
            <span class="w-[4.5rem] shrink-0 font-mono text-[0.72rem] text-faint">status</span>
            <span class="field justify-between">delivered <span class="text-faint">▾</span></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-[4.5rem] shrink-0 font-mono text-[0.72rem] text-faint">placed_at</span>
            <span class="field font-mono text-[0.72rem]">2026-08-03 14:15:58+05:30</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-[4.5rem] shrink-0 font-mono text-[0.72rem] text-faint"><span class="text-amber">⚿</span> id</span>
            <span class="field min-w-0 truncate border-blue/60 font-mono text-[0.72rem] ring-3 ring-blue/15">01a207ae-9328-7dab…</span>
            <span class="field w-auto shrink-0 font-medium">v7</span>
          </div>
        </div>
      </article>

      <!-- Filters -->
      <article class="tile md:col-span-2">
        <div class="p-6 md:p-7">
          <h3 class="tile-title">Filters that combine</h3>
          <p class="tile-body">Equals, contains, in, like, is null and more, joined with AND or OR. No SQL needed.</p>
        </div>
        <div class="mx-6 mt-auto mb-6 flex flex-wrap items-center gap-2 md:mx-7" aria-hidden="true">
          <span class="chip"><span class="font-mono text-blue">status</span><span class="text-faint">=</span>delivered</span>
          <span class="inline-flex h-7 overflow-hidden rounded-full border border-line-strong text-[0.7rem] font-semibold">
            <span class="bg-fg px-2.5 leading-7 text-bg">AND</span><span class="px-2.5 leading-7 text-faint">OR</span>
          </span>
          <span class="chip"><span class="font-mono text-blue">total</span><span class="text-faint">&gt;</span>100</span>
          <span class="chip"><span class="font-mono text-blue">country</span><span class="text-faint">in</span>DE, NL, SE</span>
          <span class="chip border-dashed text-faint">+ Add filter</span>
        </div>
      </article>

      <!-- Import -->
      <article class="tile md:col-span-2">
        <div class="p-6 md:p-7">
          <h3 class="tile-title">Imports in gigabytes</h3>
          <p class="tile-body">CSV, TSV or JSON Lines, gzipped or not, streamed through COPY. A bad row rolls back and names the line.</p>
        </div>
        <div class="mx-6 mt-auto mb-6 rounded-xl border border-line-strong bg-bg p-4 md:mx-7" aria-hidden="true">
          <div class="flex items-center gap-2 text-[0.8rem]">
            <span class="truncate font-mono">orders_2026.csv.gz</span>
            <span class="ml-auto shrink-0 text-[0.72rem] text-faint">→ orders</span>
          </div>
          <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-surface-2">
            <div class="progress h-full rounded-full bg-[image:var(--brand)]"></div>
          </div>
          <div class="mt-2 flex justify-between text-[0.7rem] text-faint tabular-nums">
            <span>61 MB/s</span><span>4.8M rows</span><span>9 s left</span>
          </div>
        </div>
      </article>

      <!-- Schema: the New table dialog in miniature, column builder feeding the SQL preview -->
      <article class="tile md:col-span-6">
        <div class="grid md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
          <div class="p-6 md:p-8">
            <h3 class="tile-title">Schema changes you read before they run</h3>
            <p class="tile-body max-w-[44ch]">Create tables, add and retype columns, and build indexes concurrently. Every dialog shows the exact SQL it will run.</p>

            <div class="mt-7 overflow-hidden rounded-xl border border-line-strong bg-bg text-[0.78rem]" aria-hidden="true">
              <div class="flex items-center gap-2 border-b border-line px-3.5 py-2.5">
                <span class="text-faint">New table</span>
                <span class="font-mono text-fg">public.invoices</span>
                <span class="ml-auto text-[0.7rem] text-faint">{columns.length} columns</span>
              </div>
              {
                columns.map((c) => (
                  <div class="flex items-center gap-2 border-b border-line px-3.5 py-2 last:border-b-0">
                    <span class="w-[5.6rem] shrink-0 truncate font-mono text-fg">{c.name}</span>
                    <span class="w-[6.2rem] shrink-0 truncate rounded-md border border-line px-1.5 py-0.5 font-mono text-[0.7rem] text-green">{c.type}</span>
                    <span class="flex gap-1">
                      {['PK', 'NN', 'AI'].map((f) => (
                        <span class:list={['rounded px-1 py-px font-mono text-[0.62rem]', c.flags.includes(f) ? 'bg-fg text-bg' : 'border border-line text-faint']}>{f}</span>
                      ))}
                    </span>
                    {c.ref && <span class="ml-auto truncate font-mono text-[0.7rem] text-blue">→ {c.ref}</span>}
                  </div>
                ))
              }
            </div>
          </div>

          <div class="flex min-w-0 p-6 pt-0 md:p-8 md:pl-0">
            <div class="sql flex min-w-0 flex-1 flex-col overflow-hidden rounded-xl border border-line-strong bg-bg">
              <div class="flex items-center gap-2 border-b border-line px-3.5 py-2.5 text-[0.75rem]">
                <svg viewBox="0 0 24 24" class="size-3.5 text-muted" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"></path></svg>
                <span class="text-muted">SQL preview</span>
                <span class="ml-auto rounded-full bg-fg px-2.5 py-1 text-[0.7rem] font-medium text-bg">Create table</span>
              </div>
              <ol class="code flex-1 overflow-x-auto py-3 text-[0.74rem] leading-[1.85]" aria-label="SQL preview of the CREATE TABLE and CREATE INDEX statements">
                {
                  sqlLines.map((l, i) => (
                    <li class="flex whitespace-pre pr-4">
                      <span class="w-9 shrink-0 pr-3 text-right text-faint/60 select-none">{i + 1}</span>
                      <span set:html={l} />
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <!-- The details: a ruled grid of cells with markers where lines cross. -->
  <div class="relative grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
    {
      cells.map(([ic, title, body], i) => (
        <div class:list={['cell relative border-line p-7 md:p-9', 'border-b', i % 3 !== 2 && 'lg:border-r', i % 2 === 0 && 'sm:max-lg:border-r', i >= 6 && 'lg:border-b-0', i >= 8 && 'sm:max-lg:border-b-0']}>
          {i % 3 !== 0 && i >= 3 && <Cross class="-top-[7px] -left-[7px] hidden lg:block" />}
          <svg viewBox="0 0 24 24" class="size-5 text-muted" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon[ic]} />
          <h3 class="mt-4 font-medium">{title}</h3>
          <p class="mt-1.5 text-[0.92rem] text-muted">{body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface) 45%);
  }
  .tile-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tile-body {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .field {
    display: flex;
    flex: 1;
    align-items: center;
    height: 2rem;
    padding-inline: 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.85rem;
    padding-inline: 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .cell {
    transition: background-color 0.2s;
  }
  .cell:hover {
    background: var(--surface);
  }
  .spark-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @supports (animation-timeline: view()) {
    .spark-line {
      animation: draw linear both;
      animation-timeline: view();
      animation-range: entry 15% cover 40%;
    }
  }
  .progress {
    animation: progress 7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes progress {
    from {
      width: 4%;
    }
    85%,
    to {
      width: 100%;
    }
  }
</style>

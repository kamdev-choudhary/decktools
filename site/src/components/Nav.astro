---
import Logo from './Logo.astro';
const repo = 'https://github.com/kamdev-choudhary/pgdeck';
---

<header class="sticky top-0 z-40 border-b border-night-line bg-night/75 text-night-ink backdrop-blur-xl backdrop-saturate-150">
  <nav class="wrap flex h-16 items-center gap-6" aria-label="Main">
    <a href="#top" class="flex items-center gap-2.5 text-[1.15rem] font-bold tracking-tight">
      <Logo class="size-7" />
      pgdeck
    </a>
    <div class="ml-auto hidden items-center gap-7 text-[0.93rem] text-night-soft md:flex">
      <a href="#features" class="transition-colors hover:text-night-ink">Features</a>
      <a href="#tour" class="transition-colors hover:text-night-ink">Tour</a>
      <a href="#deploy" class="transition-colors hover:text-night-ink">Deploy</a>
      <a href={`${repo}#readme`} class="transition-colors hover:text-night-ink">Docs</a>
    </div>
    <a
      href={repo}
      class="ml-auto inline-flex h-9 items-center gap-2 rounded-full bg-night-ink px-4 text-sm font-semibold text-night transition-opacity hover:opacity-85 md:ml-0"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
      </svg>
      Star on GitHub
    </a>
  </nav>
</header>

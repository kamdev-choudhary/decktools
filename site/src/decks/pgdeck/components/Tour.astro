---
import Corners from '../../../components/Corners.astro';
import Shot from './Shot.astro';

const stops = [
  { id: 'browse', shot: 'table', label: 'Browse', body: 'Sort, page and filter millions of rows. Headers show each type and where its foreign key points.', alt: 'The orders table: order ids, customer UUIDs linking to customers, statuses, totals and timestamps, with filters and pagination.' },
  { id: 'edit', shot: 'editor', label: 'Edit', body: 'Double-click a row for a form with the right control for each column, including a picker for foreign keys.', alt: 'The Edit row dialog for an order, with a foreign key Browse button, a status menu and date pickers.' },
  { id: 'sql', shot: 'sql', label: 'SQL', body: 'Highlighting and table autocomplete. Run the selection or the whole script, keep history, export results.', alt: 'The SQL editor with a revenue-by-country query and its result rows.' },
  { id: 'structure', shot: 'structure', label: 'Structure', body: 'Columns, indexes, constraints and references, each with actions to change or drop it.', alt: 'The Structure tab for orders with columns, indexes and constraints.' },
  { id: 'create', shot: 'create-table', label: 'Create', body: 'Build a table column by column, with constraints and foreign keys, and read the SQL as you go.', alt: 'The New table dialog with columns, constraint toggles and a references picker.' },
  { id: 'import', shot: 'import', label: 'Import', body: 'Drop data files or a pg_dump backup. Files are matched to tables by name and streamed in.', alt: 'The Import page with drop zones for data files and backups.' },
  { id: 'export', shot: 'export', label: 'Export', body: 'Pick tables and a format, or download the whole database as a restorable backup.', alt: 'The Export page with a table list and format options.' },
];
---

<section id="tour" class="section">
  <Corners />
  <div class="pad py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <h2 class="h2">Take the tour.</h2>
        <p class="lede mt-5">Real screens from pgdeck, running against a demo shop database.</p>
      </div>
      <div role="tablist" aria-label="pgdeck screens" class="tour-tabs flex max-w-full gap-1 overflow-x-auto rounded-full border border-line-strong bg-surface p-1 [scrollbar-width:none]">
        {
          stops.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="h-8 shrink-0 rounded-full px-3.5 text-sm text-muted transition-colors hover:text-fg aria-selected:bg-fg aria-selected:text-bg"
            >
              {s.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="relative mt-10">
      <div class="tour-glow pointer-events-none absolute -inset-x-6 -inset-y-6 -z-10" aria-hidden="true"></div>
      <div class="brand-border rounded-[16px] bg-surface">
        <div class="overflow-hidden rounded-[16px]">
          <div class="window-bar" aria-hidden="true">
            <div class="dots"><i></i><i></i><i></i></div>
          </div>
          <div class="grid">
            {
              stops.map((s, i) => (
                <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-active={i === 0 ? '' : undefined} class="panel col-start-1 row-start-1">
                  <Shot name={s.shot} alt={s.alt} sizes="(min-width: 1200px) 1080px, 94vw" />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    {
      stops.map((s, i) => (
        <p data-caption={s.id} hidden={i !== 0} class="mx-auto mt-6 max-w-2xl text-center text-muted">
          {s.body}
        </p>
      ))
    }
  </div>
</section>

<style>
  .tour-glow {
    background:
      radial-gradient(closest-side at 20% 40%, color-mix(in oklab, var(--blue) 40%, transparent), transparent),
      radial-gradient(closest-side at 85% 70%, color-mix(in oklab, var(--pink) 32%, transparent), transparent);
    filter: blur(50px);
    opacity: 0.45;
  }
  .panel {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .panel[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tour-tabs [role=tab]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const id = t.id.replace('tab-', '');
      document.getElementById(`panel-${id}`)?.toggleAttribute('data-active', on);
      const caption = document.querySelector<HTMLElement>(`[data-caption="${id}"]`);
      if (caption) caption.hidden = !on;
    }
    if (focus) tab.focus();
    tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = ({ ArrowRight: 1, ArrowLeft: -1 } as Record<string, number>)[e.key];
      if (step) {
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length]!, true);
      }
    });
  });
</script>

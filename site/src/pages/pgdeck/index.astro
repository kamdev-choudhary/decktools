---
import Base from '../layouts/Base.astro';
import Bento from '../components/Bento.astro';
import Closing from '../components/Closing.astro';
import Deploy from '../components/Deploy.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import Pipeline from '../components/Pipeline.astro';
import Tour from '../components/Tour.astro';
---

<Base
  title="pgdeck: the PostgreSQL admin that starts with one command"
  description="Browse and edit data, run SQL, manage tables and watch live stats for every database on your PostgreSQL server. Run npx pgdeck and open the link."
>
  <Nav />
  <main class="rails">
    <Hero />
    <Pipeline />
    <Bento />
    <Tour />
    <Deploy />
    <Closing />
  </main>
</Base>

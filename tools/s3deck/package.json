{
  "name": "s3deck",
  "version": "0.1.2",
  "description": "A fast, modern web UI for S3 and S3-compatible storage, started with one command.",
  "type": "module",
  "license": "MIT",
  "author": "kamdev-bharatai",
  "homepage": "https://github.com/kamdev-choudhary/decktools/tree/main/tools/s3deck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/decktools.git",
    "directory": "tools/s3deck"
  },
  "bugs": {
    "url": "https://github.com/kamdev-choudhary/decktools/issues"
  },
  "bin": {
    "s3deck": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "s3",
    "minio",
    "r2",
    "aws",
    "storage",
    "browser",
    "ui",
    "s3-browser",
    "s3-client",
    "object-storage",
    "cloudflare-r2",
    "backblaze",
    "cli",
    "web-ui"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/cli/index.ts --no-auth --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src web test",
    "build": "pnpm build:web && pnpm build:cli",
    "build:web": "vite build --config web/vite.config.ts",
    "build:cli": "tsdown --config-loader tsx",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pack:check": "pnpm build && npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "S3DECK_TEST_ENDPOINT=${S3DECK_TEST_ENDPOINT:-http://localhost:9000} vitest run test/integration",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/credential-providers": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "^0.9.1",
    "archiver": "^8.0.0",
    "commander": "catalog:",
    "hono": "catalog:",
    "mime-types": "^3.0.2",
    "open": "catalog:",
    "openid-client": "^6.9.1",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/archiver": "^8.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "concurrently": "catalog:",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "hyparquet": "1.33.0",
    "lucide-react": "catalog:",
    "mammoth": "1.13.0",
    "marked": "^18.2.1",
    "oxlint": "catalog:",
    "papaparse": "^5.7.1",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.92.0",
    "read-excel-file": "9.3.14",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.1.1"
  }
}

{
  "name": "pgdeck",
  "version": "0.1.6",
  "description": "A fast, modern web UI for PostgreSQL. Run it with npx, browse and edit data, run SQL, and watch live stats.",
  "keywords": [
    "postgres",
    "postgresql",
    "database",
    "admin",
    "gui",
    "web-ui",
    "sql",
    "pgadmin",
    "dashboard",
    "cli",
    "npx"
  ],
  "homepage": "https://github.com/kamdev-choudhary/decktools/tree/main/tools/pgdeck#readme",
  "bugs": {
    "url": "https://github.com/kamdev-choudhary/decktools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/decktools.git",
    "directory": "tools/pgdeck"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pgdeck": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && pnpm build:web && pnpm build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsdown",
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch src/cli/index.ts --no-auth",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src web test",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "pnpm build && pnpm pack --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "commander": "catalog:",
    "hono": "catalog:",
    "open": "catalog:",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pg-copy-streams": "^7.0.0",
    "pg-cursor": "^2.22.1",
    "picocolors": "catalog:",
    "ws": "^8.23.0",
    "yazl": "^3.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@deck/cli": "workspace:*",
    "@deck/config": "workspace:*",
    "@deck/logger": "workspace:*",
    "@deck/security": "workspace:*",
    "@deck/server": "workspace:*",
    "@deck/ui": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.2",
    "@types/yazl": "^3.3.1",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "catalog:",
    "@xyflow/react": "^13.0.2",
    "concurrently": "catalog:",
    "html-to-image": "^1.11.13",
    "lucide-react": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "uuid": "^14.0.3",
    "vite": "catalog:"
  }
}

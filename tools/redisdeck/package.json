{
  "name": "redisdeck",
  "version": "0.1.0",
  "description": "A fast, modern web UI for Redis. Run it with npx, browse and edit keys of every type, run commands, and watch live stats.",
  "keywords": [
    "redis",
    "valkey",
    "keydb",
    "database",
    "admin",
    "gui",
    "web-ui",
    "redis-gui",
    "redis-browser",
    "dashboard",
    "cli",
    "npx"
  ],
  "homepage": "https://github.com/kamdev-choudhary/decktools/tree/main/tools/redisdeck#readme",
  "bugs": {
    "url": "https://github.com/kamdev-choudhary/decktools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/decktools.git",
    "directory": "tools/redisdeck"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "redisdeck": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && pnpm build:web && pnpm build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsdown",
    "dev": "concurrently -k -n api,web -c red,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch src/cli/index.ts --no-auth",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src web test",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "pnpm build && pnpm pack --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "commander": "^15.1.0",
    "hono": "^4.13.20",
    "ioredis": "^6.1.0",
    "open": "^11.0.4",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deck/cli": "workspace:*",
    "@deck/config": "workspace:*",
    "@deck/logger": "workspace:*",
    "@deck/security": "workspace:*",
    "@deck/server": "workspace:*",
    "@deck/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.77.0",
    "oxlint": "^1.95.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

{
  "name": "redisdeck",
  "version": "0.1.0",
  "description": "A fast, modern web UI for Redis. Run it with npx, browse and edit keys of every type, run commands, and watch live stats.",
  "keywords": [
    "redis",
    "valkey",
    "keydb",
    "database",
    "admin",
    "gui",
    "web-ui",
    "redis-gui",
    "redis-browser",
    "dashboard",
    "cli",
    "npx"
  ],
  "homepage": "https://github.com/kamdev-choudhary/decktools/tree/main/tools/redisdeck#readme",
  "bugs": {
    "url": "https://github.com/kamdev-choudhary/decktools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/decktools.git",
    "directory": "tools/redisdeck"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "redisdeck": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && pnpm build:web && pnpm build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsdown --config-loader tsx",
    "dev": "concurrently -k -n api,web -c red,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch src/cli/index.ts --no-auth",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src web test",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "pnpm build && pnpm pack --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "commander": "catalog:",
    "hono": "catalog:",
    "ioredis": "^6.1.0",
    "open": "catalog:",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deck/cli": "workspace:*",
    "@deck/config": "workspace:*",
    "@deck/logger": "workspace:*",
    "@deck/security": "workspace:*",
    "@deck/server": "workspace:*",
    "@deck/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "catalog:",
    "lucide-react": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
